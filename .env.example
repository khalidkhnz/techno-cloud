# --- Runtime ---
NODE_ENV="development"
PORT="3001"

# --- Database (Neon, pooled endpoint) ---
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/techno_deployer?sslmode=require"

# --- AWS ---
AWS_REGION="us-east-1"
ARTIFACTS_BUCKET=""
PULUMI_STATE_BUCKET=""
PULUMI_LOCK_TABLE=""
ECR_REGISTRY=""
BUILD_PROJECT_NAME=""
SSM_PREFIX="/td-dev"
STACK_LOCK_TABLE=""
IDEMPOTENCY_TABLE=""
BUILD_QUEUE_URL=""
DEPLOY_QUEUE_URL=""

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
APP_ORIGIN="http://localhost:3000"

# --- Webhook signing secrets (required per provider to accept its webhooks) ---
GITHUB_WEBHOOK_SECRET=""
GITLAB_WEBHOOK_SECRET=""
BITBUCKET_WEBHOOK_SECRET=""

# --- Email (Nodemailer / SES) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@deploy.internal"

# --- Deploy runtime (used by Pulumi programs, typically inside the deploy CodeBuild job) ---
PULUMI_BACKEND_URL="s3://td-dev-pulumi-state"
PULUMI_CONFIG_PASSPHRASE=""
APP_PREFIX="td-dev"                 # resource name prefix; app roles are ${APP_PREFIX}-app-*
APP_BOUNDARY_ARN=""                 # permissions boundary ARN required on app roles
AMPLIFY_ACCESS_TOKEN=""            # git token for Amplify to pull private repos

# --- Platform ---
BASE_DOMAIN="deploy.internal"
ADMIN_EMAIL="admin@company.com"   # seeded as the first owner (run: pnpm --filter @techno-deployer/db db:seed)

# --- Web (Next.js, client-exposed) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
