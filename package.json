{
  "name": "techno-deployer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @techno-deployer/db db:generate",
    "db:migrate": "pnpm --filter @techno-deployer/db db:migrate",
    "db:seed": "pnpm --filter @techno-deployer/db db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@techno-deployer/core": "workspace:*",
    "@techno-deployer/costs": "workspace:*",
    "@techno-deployer/providers": "workspace:*",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0"
  }
}
